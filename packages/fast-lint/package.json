{
  "name": "@ls-stack/fast-lint",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Fast type-aware lint rules for TypeScript and React, running natively on tsrs, the Rust port of the TypeScript checker",
  "type": "module",
  "scripts": {
    "test": "cargo test",
    "lint": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "build": "pnpm test && pnpm lint && pnpm run build:no-test",
    "build:no-test": "node scripts/build.mjs",
    "pre-publish": "pnpm build"
  },
  "bin": {
    "fast-lint": "./bin/fast-lint.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    }
  },
  "files": [
    "bin",
    "lib",
    "dist"
  ],
  "repository": "github:lucaslos/eslint-plugin-extended-lint",
  "author": "Lucas Santos",
  "engines": {
    "node": ">=22.18.0"
  }
}
