{
  "name": "@ls-stack/extended-lint-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "test:ui": "pnpm --filter @ls-stack/extended-lint test:ui",
    "build:no-test": "pnpm --filter @ls-stack/extended-lint build:no-test",
    "run-in-test-project": "pnpm --filter @ls-stack/extended-lint run-in-test-project",
    "publish-package": "pkg-manager publish"
  },
  "repository": "github:lucaslos/eslint-plugin-extended-lint",
  "author": "Lucas Santos",
  "devDependencies": {
    "@ls-stack/pkg-manager": "^0.12.0"
  }
}
